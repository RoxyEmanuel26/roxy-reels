# === Global Security Headers ===
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET, OPTIONS
  Access-Control-Allow-Headers: Content-Type, X-API-Key, X-Client-Site

# === RFC 8288 Link Headers — AI Agent Discovery (Homepage) ===
/
  Link: </.well-known/api-catalog>; rel="api-catalog"
  Link: </.well-known/agent-skills/index.json>; rel="describedby"; type="application/json"
  Link: </llms.txt>; rel="describedby"; type="text/plain"
  Link: </sitemaps/sitemap_index.xml>; rel="sitemap"; type="application/xml"

# === .well-known — AI Agent Discovery Files ===
/.well-known/api-catalog
  Content-Type: application/linkset+json
  Cache-Control: public, max-age=86400
  Access-Control-Allow-Origin: *

/.well-known/agent-skills/index.json
  Content-Type: application/json
  Cache-Control: public, max-age=86400
  Access-Control-Allow-Origin: *

/.well-known/agent-skills/*
  Content-Type: text/markdown; charset=utf-8
  Cache-Control: public, max-age=86400
  Access-Control-Allow-Origin: *

# === Static Assets — Long Cache (1 year, immutable) ===
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# === Sitemap XML — Cache 24 jam di CDN ===
/sitemaps/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=43200
  CDN-Cache-Control: public, max-age=86400
  Content-Type: application/xml; charset=utf-8

# === API Endpoints — Cache 5 menit di CDN ===
/api/*
  Cache-Control: public, s-maxage=300, stale-while-revalidate=600
  CDN-Cache-Control: public, max-age=300

# === Robots.txt, Ads.txt & Service Worker ===
/robots.txt
  Cache-Control: no-cache, no-store, must-revalidate
/ads.txt
  Cache-Control: no-cache, no-store, must-revalidate
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
