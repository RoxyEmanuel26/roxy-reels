# === Global Security Headers ===
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  # FIX: X-XSS-Protection: 1 deprecated & can cause side-channel in old browsers. Set to 0, rely on CSP.
  X-XSS-Protection: 0
  # Referrer-Policy: no-referrer-when-downgrade agar Adsterra bisa membaca URL lengkap saat RTB bidding
  Referrer-Policy: no-referrer-when-downgrade
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET, OPTIONS
  Access-Control-Allow-Headers: Content-Type, X-API-Key, X-Client-Site
  # Permissions-Policy untuk mengizinkan autoplay dan fullscreen di player
  Permissions-Policy: autoplay=(*), fullscreen=(*)
  # FIX: X-Frame-Options prevents clickjacking / iframe embedding by third parties
  X-Frame-Options: SAMEORIGIN
  # FIX: Content-Security-Policy — baseline protection against XSS and unauthorized script injection
  # 'unsafe-inline' & 'unsafe-eval' diperlukan untuk Adsterra, JSON-LD, dan inline event handlers
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https: blob:; style-src 'self' 'unsafe-inline' https:; img-src 'self' https: data: blob:; media-src 'self' https: blob:; connect-src 'self' https:; frame-src 'self' https:; base-uri 'self'; form-action 'self';

# === RFC 8288 Link Headers — AI Agent Discovery (Homepage) ===
# Cache-Control: no-store di sini WAJIB untuk geo-redirect:
# Tanpa ini, Cloudflare CDN bisa meng-cache redirect /ko/ untuk user Korea
# dan melayani redirect yang sama ke user dari negara lain.
# FIX: Merged duplicate '/' blocks into one canonical definition.
/
  Link: </.well-known/api-catalog>; rel="api-catalog"
  Link: </.well-known/agent-skills/index.json>; rel="describedby"; type="application/json"
  Link: </llms.txt>; rel="describedby"; type="text/plain"
  Link: </sitemaps/sitemap_index.xml>; rel="sitemap"; type="application/xml"
  Cache-Control: no-store, no-cache
  Vary: CF-IPCountry, Cookie

# === .well-known — AI Agent Discovery Files ===
/.well-known/api-catalog
  Content-Type: application/linkset+json
  Cache-Control: public, max-age=86400
  Access-Control-Allow-Origin: *

/.well-known/agent-skills/index.json
  Content-Type: application/json
  Cache-Control: public, max-age=86400
  Access-Control-Allow-Origin: *

/.well-known/agent-skills/*
  Content-Type: text/markdown; charset=utf-8
  Cache-Control: public, max-age=86400
  Access-Control-Allow-Origin: *

# === Static Assets — Long Cache (1 year, immutable) ===
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# === Sitemap XML — Cache 24 jam di CDN ===
/sitemaps/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=43200
  CDN-Cache-Control: public, max-age=86400
  Content-Type: application/xml; charset=utf-8

# FIX: Hapus rule global /api/* yang meng-cache SEMUA endpoint API selama 7 hari.
# Ini sangat berbahaya: jika ada endpoint dinamis (search, user session, dll.)
# response akan di-cache publik antar pengguna (cache poisoning / privacy leak).
# Masing-masing function di functions/api/* sudah mengatur Cache-Control sendiri.

# === Robots.txt, Ads.txt & Service Worker ===
/robots.txt
  Cache-Control: no-cache, no-store, must-revalidate
/ads.txt
  Cache-Control: no-cache, no-store, must-revalidate
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

# === index.html — WAJIB tidak di-cache oleh browser dan CDN ===
# Script Popunder & Social Bar Adsterra ada di dalam file ini.
# Jika di-cache, script iklan tidak dimuat ulang saat reload → Popunder MENGHILANG.
/index.html
  Cache-Control: no-cache, no-store, must-revalidate
